entity Api:
    """
    Entity representing the api of a netbird management server.

    :attr agent_name: The name of the agent deploying the resources reachable
        through this api.
    :attr server_url: The base url of the netbird management api.
    :attr token: The token used to authenticate against the management api.
    """
    string agent_name
    string server_url = "https://api.netbird.io"
    string token
end

index Api(agent_name)

implement Api using std::none


entity ResourceABC extends std::PurgeableResource, std::ManagedResource:
    """
    Base resource for all netbird resources.

    :attr name: The name of the resource, unique within its type, for a given
        api.
    """
    string name
end

ResourceABC.api [1] -- Api.resources [0:]
"""
The api that the resource should be configured at.
"""

index ResourceABC(api, name)
