import files::json


entity Api:
    """
    Entity representing the api of a netbird management server.

    :attr agent_name: The name of the agent deploying the resources reachable
        through this api.
    :attr management_url: The base url of the netbird management server, without
        the `/api` suffix.  Self-hosted deployments use their own url.
    :attr api_token: A personal access token, authorized to manage the account.
    """
    string agent_name
    string management_url = "https://api.netbird.io"
    string api_token
end

index Api(agent_name)

implement Api using std::none


entity ResourceABC extends std::PurgeableResource, std::ManagedResource, files::json::JsonResource:
    """
    Base resource for all netbird resources.

    This entity only carries the plumbing a resource is deployed with, and is
    deliberately not serializable: it must not end up in the body sent to the api.

    :attr id: The opaque id the api gave this object.  The model never knows it, so
        it is a reference that is resolved from the facts the handler publishes, at
        the moment the value is needed on the agent.  Point another resource at this
        object with it, rather than going digging through the api.
    """
    bool send_event = true
    bool serialize = false
    string id
end

ResourceABC.api [1] -- Api.resources [0:]
"""
The api that the resource should be configured at.
"""


implementation object_id for ResourceABC:
    """
    The api addresses every object by an opaque id, which it only hands out once the
    object exists.  The handler publishes it as a fact, and this reference reads it
    back from there on the agent.
    """
    self.id = std::create_fact_reference(self, "id")
end

implement ResourceABC using object_id


entity JsonObjectABC extends ResourceABC, files::json::SerializableEntity:
    """
    Base entity for every object of the netbird api.

    They are all json objects, and this module co-manages them with whoever else
    edits the account: an attribute left null is kept as the api currently holds it,
    only the values the model sets are enforced.  The resource is its own desired
    state, so each object is one entity: the attributes declared here are the ones
    the api reports about itself.
    """
    string path = "."
end


implementation json_object for JsonObjectABC:
    """
    The object serializes itself: it is both the resource inmanta deploys and the
    json object the api holds.
    """
    self.resource = self
end

implement JsonObjectABC using parents, json_object


typedef user_role_t as string matching self in [
    "owner", "admin", "user", "network_admin", "billing_admin", "auditor",
]


entity User extends JsonObjectABC:
    """
    Manage a user, or a service user, of the netbird account.

    Api documentation: https://docs.netbird.io/api/resources/users

    Every attribute but the name is optional, and left null it is not managed: the
    user keeps whatever value the account holds for it.  The api does require some
    of them to create a user that doesn't exist yet (the role always, and the email
    address of anyone who is not a service user), and it rejects a change to the ones
    it only takes at creation.

    :attr name: The full name of the user, which is what identifies it.  The api only
        takes it when the user is created, it is not enforced afterwards.
    :attr email: The email address of the user.  An invite is sent to it when the
        user is created.  The api doesn't keep it for a service user.
    :attr role: The role of the user on the account.
    :attr auto_groups: The ids of the groups the peers this user registers are
        automatically added to.
    :attr is_blocked: Whether the user is blocked from using the account.
    :attr is_service_user: Whether the user is a service user, i.e. a user that only
        exists to hold access tokens and can not log in.  The api only takes it when
        the user is created.
    """
    string name
    string? email = null
    user_role_t? role = null
    string[]? auto_groups = null
    bool? is_blocked = null
    bool? is_service_user = null
end

index User(api, name)

implement User using parents


entity Group extends JsonObjectABC:
    """
    Manage a group of the netbird account.

    Api documentation: https://docs.netbird.io/api/resources/groups

    A group is what every access rule of the account is expressed in terms of: it
    holds peers, and the policies, setup keys, users and dns settings point at it.

    Every fresh account comes with an `All` group holding all of its peers, which the
    api refuses to rename or to delete.  Managing it with this resource only works as
    long as the model asks for nothing the api would have to change.

    :attr name: The name of the group, which is what identifies it.  The api rejects
        a second group with a name it already has.
    :attr peers: The ids of the peers that are members of the group.  The api reports
        each of them as an object, but only takes ids on a write: the handler sends
        back the ids.  An id the account doesn't know is dropped silently.
    """
    string name
    string[]? peers = null
end

index Group(api, name)

implement Group using parents


typedef setup_key_type_t as string matching self in ["one-off", "reusable"]


entity SetupKey extends JsonObjectABC:
    """
    Manage a setup key of the netbird account, the token a peer registers itself
    with.

    Api documentation: https://docs.netbird.io/api/resources/setup-keys

    Every attribute but the name is optional, and left null it is not managed: the
    setup key keeps whatever value the account holds for it.  The api only takes the
    revocation and the auto groups on an update, so everything else is applied when
    the key is created and never enforced afterwards.  It does require the type to
    create a key that doesn't exist yet.

    :attr _key: The generated key itself, which a peer registers with.  Like the id,
        the model never knows it: it is a reference resolving the fact the handler
        publishes.  The api shows the key in clear in the create response only and
        reports it masked from then on, so that fact is published on the create and
        never again — a key this module adopted rather than created has none, and a
        reference to it can not be resolved.  It carries a leading underscore because
        the model must not send it back: it is the api that generates it.
    :attr name: The name of the setup key, which is what identifies it here.  The api
        allows several keys with the same name, this module does not.
    :attr type: Whether the key registers a single peer (`one-off`) or as many as the
        usage limit allows (`reusable`).  Only applied when the key is created, and
        required to create one.
    :attr expires_in: How long, in seconds, the key stays valid.  The api reports the
        moment it expires rather than this duration, so it is only applied when the
        key is created, and a later change to it is not enforced.
    :attr revoked: Whether the key is revoked.  A revoked key can not register peers
        anymore, and the api refuses to un-revoke one: asking for that is a failed
        deploy.  The api only takes the revocation on an update, so a key the model
        wants revoked from the start is created and then revoked.
    :attr auto_groups: The ids of the groups the peers registered with this key are
        automatically added to.  The api rejects the account's `All` group here, and
        an id it doesn't know.
    :attr usage_limit: How many peers may register with this key, zero meaning no
        limit.  Only applied when the key is created, and forced to one for a
        `one-off` key.
    :attr ephemeral: Whether the peers registered with this key are removed from the
        account when they stay offline for longer than 10 minutes.  Only applied when
        the key is created.
    :attr allow_extra_dns_labels: Whether the peers registered with this key may carry
        extra dns labels.  Only applied when the key is created.
    """
    string name
    setup_key_type_t? type = null
    int? expires_in = null
    bool? revoked = null
    string[]? auto_groups = null
    int? usage_limit = null
    bool? ephemeral = null
    bool? allow_extra_dns_labels = null
    string _key
end

index SetupKey(api, name)


implementation setup_key_secret for SetupKey:
    """
    The key the api generated is only ever shown once, in the response to the call
    that created it.  The handler publishes it as a fact there, and this reference
    reads it back on the agent, at the moment whoever registers a peer needs it.
    """
    self._key = std::create_fact_reference(self, "key")
end


implement SetupKey using parents, setup_key_secret


entity Peer extends JsonObjectABC:
    """
    Manage a peer that has joined the netbird account.

    Api documentation: https://docs.netbird.io/api/resources/peers

    A peer can not be created through the api: it comes into existence by registering
    itself with a setup key or an sso login.  This resource therefore adopts a peer
    that already joined, keeps the settings the api lets us change in line with the
    model, and removes the peer from the account when it is purged.  Deploying it for
    a peer that has not registered yet skips, loudly: there is nothing the handler
    could do to make that desired state true.

    The peer is identified by its hostname rather than by its name: the name is one of
    the values this resource manages, and an object can not be found back by a value
    the model rewrites.  The hostname is what the peer reports about itself when it
    registers, and the api offers no way to change it, so it is the only stable handle
    on a peer besides the id the model never knows.

    Every attribute but the hostname is optional, and left null it is not managed: the
    peer keeps whatever value the account holds for it.

    :attr hostname: The hostname the peer reported when it registered, which is what
        identifies it.  It is not settable.
    :attr name: The name of the peer on the account, which its dns label is derived
        from.  It defaults to the hostname when the peer registers.
    :attr ssh_enabled: Whether the netbird ssh server runs on the peer.
    :attr login_expiration_enabled: Whether the peer's login expires and has to be
        renewed interactively.  The api rejects enabling it on a peer that joined with
        a setup key rather than with an sso login.
    :attr inactivity_expiration_enabled: Whether the peer's session expires while it
        is disconnected.  The api rejects enabling it on a peer that joined with a
        setup key rather than with an sso login.
    """
    string hostname
    string? name = null
    bool? ssh_enabled = null
    bool? login_expiration_enabled = null
    bool? inactivity_expiration_enabled = null
end

index Peer(api, hostname)

implement Peer using parents


entity Network extends JsonObjectABC:
    """
    Manage a network of the netbird account.

    Api documentation: https://docs.netbird.io/api/resources/networks

    A network on its own is an empty container: it is the resources
    (`netbird::NetworkResource`) that say which addresses it gives access to, and the
    routers (`netbird::NetworkRouter`) that say which peers route the traffic to them.
    Both of them are addressed under the id of the network they belong to, which the
    api hands out and the model reads back from `Network.id`.  The api answers 404 to a
    resource or a router created in a network that doesn't exist yet, and nothing in
    this module orders them: a model declaring both has to require the network from the
    objects addressed under it.

    Deleting a network takes the resources and the routers it holds with it, the api
    doesn't ask for them to be removed first.

    :attr name: The name of the network, which is what identifies it here.  The api
        allows several networks to carry the same name, this module does not: it manages
        the first one the listing reports.
    :attr description: A free form description of the network.
    """
    string name
    string? description = null
end

index Network(api, name)

implement Network using parents


entity NetworkResource extends JsonObjectABC:
    """
    Manage a resource of a network: an address, or a range of them, that the peers of
    the groups it is in can reach through the routers of the network.

    Api documentation: https://docs.netbird.io/api/resources/networks

    :attr _network: The id of the network this resource belongs to.  It is not part of
        the object the api holds, it is the network the resource is addressed under.
    :attr name: The name of the resource, which is what identifies it.  The api keeps it
        unique within a network and allows the same name in two networks; this module
        does not: the id of the network is only known on the agent, so it can not take
        part in the identity of the resource inmanta deploys.
    :attr description: A free form description of the resource.
    :attr address: The address the resource stands for: a host (`1.1.1.1`, `1.1.1.1/32`),
        a subnet (`192.168.0.0/24`) or a domain (`example.com`, `*.example.com`).  The
        api derives the type of the resource from it, and refuses to store a resource
        without one, which is why it is the one value here that is not optional.  A host
        address is kept as the network it is alone in: `1.1.1.1` is reported as
        `1.1.1.1/32`.
    :attr enabled: Whether the resource is reachable through the network.
    :attr groups: The ids of the groups the resource is in.  Those are the groups a
        policy grants access to it with.
    """
    string _network
    string name
    string address
    string? description = null
    bool? enabled = null
    string[]? groups = null
end

index NetworkResource(api, name)

implement NetworkResource using parents


entity NetworkRouter extends JsonObjectABC:
    """
    Manage a router of a network: the peer, or the peers of the groups, that route the
    traffic towards the resources of the network.

    Api documentation: https://docs.netbird.io/api/resources/networks

    The api gives a router no name of its own, it is only known by the peer or the
    peer groups it routes for.  That is what the handler matches a router of the
    network on, so a router that is made to route for another target is a new one: the
    api takes as many routers for the same target as it is given, and the one that was
    there before is left behind rather than updated.

    Exactly one of `peer` and `peer_groups` has to be set: the api refuses a router with
    neither and a router with both, on a create as well as on an update, and says so.

    :attr _name: The name this model knows the router by.  The api does not store it,
        it only identifies the resource inmanta deploys, and it must be unique.
    :attr _network: The id of the network this router belongs to.  It is not part of
        the object the api holds, it is the network the router is addressed under.
    :attr peer: The id of the peer that routes the traffic.  Mutually exclusive with
        `peer_groups`.
    :attr peer_groups: The ids of the groups whose peers route the traffic.  Mutually
        exclusive with `peer`.
    :attr metric: The priority of this router among the routers of the network, the
        lowest number first.  The api takes any integer.
    :attr masquerade: Whether the routing peers masquerade the traffic they route.
    :attr enabled: Whether the router routes traffic.
    """
    string _name
    string _network
    string? peer = null
    string[]? peer_groups = null
    int? metric = null
    bool? masquerade = null
    bool? enabled = null
end

index NetworkRouter(api, _name)

implement NetworkRouter using parents
